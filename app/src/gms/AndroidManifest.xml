<?xml version="1.0" encoding="utf-8"?>
<!-- GMS flavor only. The Wear companion bridge lives here so FOSS/Izzy (F-Droid)
     builds stay free of Google Play Services. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to keep the bridge alive while handling watch requests over BT. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application>
        <service
            android:name="com.metrolist.music.wear.WearMediaBridgeService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.BIND_LISTENER" />
            </intent-filter>
        </service>
    </application>
</manifest>
